---
title: "Концептуальное ядро v0 — Режимы и жизненный цикл"
---
graph TD
    subgraph REGIME["Формирование режима допуска"]
        A02["А02. Торговая<br/>площадка"]
        A05["А05. Уровень<br/>листинга"]
        V02["В02/В03. Класс /<br/>подкласс инструмента"]
        G01["Г01. Режим допуска"]

        A02 --> G01
        A05 --> G01
        V02 --> G01
    end

    subgraph ARCHITECTURE["Архитектура допуска (Г04)"]
        G02["Г02. Официальный<br/>листинг"]
        G03["Г03. Допуск<br/>к торгам"]
        G04_SPLIT{"Разделены?"}

        G04_SPLIT -->|Да| G02
        G04_SPLIT -->|Да| G03
        G04_SPLIT -->|Нет| G02_G03["Единый режим:<br/>листинг = допуск"]
    end

    subgraph ADMISSION_TYPE["Тип допуска"]
        G05["Г05. Первичный<br/>допуск"]
        G06["Г06. Вторичный<br/>допуск"]
        G06 -.->|вариант с<br/>атрибутом| G05
    end

    subgraph LIFECYCLE["Г07. Жизненный цикл допуска"]
        direction LR
        G07_1["Г07.1<br/>Первичный<br/>допуск"]
        G07_2["Г07.2<br/>Поддержание"]
        G07_3["Г07.3<br/>Приостановка"]
        G07_4["Г07.4<br/>Исключение"]

        G07_1 --> G07_2
        G07_2 --> G07_3
        G07_3 -->|снятие| G07_2
        G07_3 --> G07_4
        G07_2 -->|принудительное| G07_4
        G07_2 -->|добровольное| G07_4
    end

    G01 --> G04_SPLIT
    G01 --> G05
    G05 --> G07_1

    %% Субъекты
    B02["Б02. Оператор<br/>площадки"] -->|решение| G03
    B03["Б03. Листинговый<br/>орган"] -->|решение| G02
    B01["Б01. Эмитент"] -->|заявление| G05

    %% Стили
    classDef regime fill:#f0e6d0,stroke:#b8860b,stroke-width:2px
    classDef lifecycle fill:#e0e8f8,stroke:#4169e1,stroke-width:2px
    classDef arch fill:#f0d8d8,stroke:#b22222,stroke-width:2px
    classDef subject fill:#e8e0d8,stroke:#8b7355,stroke-width:2px

    class G01,G05,G06 regime
    class G07_1,G07_2,G07_3,G07_4 lifecycle
    class G02,G03,G04_SPLIT,G02_G03 arch
    class B01,B02,B03 subject
