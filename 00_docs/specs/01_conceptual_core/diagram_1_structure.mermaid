---
title: "Концептуальное ядро v0 — Структурная иерархия"
---
graph TD
    subgraph BLOCK_A["Блок А. Структурные контейнеры"]
        A01["А01. Юрисдикция"]
        A02["А02. Торговая площадка"]
        A03["А03. Тип рынка"]
        A04["А04. Специализированный<br/>сегмент"]
        A05["А05. Уровень листинга"]
    end

    subgraph BLOCK_B["Блок Б. Субъекты"]
        B01["Б01. Эмитент"]
        B02["Б02. Оператор площадки"]
        B03["Б03. Листинговый орган"]
        B04["Б04. Регулятор"]
        B05["Б05. Спонсор / советник"]
    end

    subgraph BLOCK_V["Блок В. Объекты"]
        V01["В01. Финансовый<br/>инструмент"]
        V02["В02. Класс<br/>инструментов"]
        V03["В03. Подкласс<br/>инструментов"]
        V04["В04. Разделение<br/>требований:<br/>эмитент / инструмент"]
    end

    %% Иерархия контейнеров
    A01 -->|содержит| A02
    A02 -->|характеризуется| A03
    A02 -->|может содержать| A04
    A02 -->|может содержать| A05

    %% Субъекты и контейнеры
    A01 -->|содержит| B04
    B04 -->|устанавливает правила для| B02
    B02 -->|управляет| A02
    B02 -.->|может совмещать<br/>функции| B03
    B04 -.->|может выполнять<br/>функции| B03

    %% Объекты
    B01 -->|выпускает| V01
    V01 -->|относится к| V02
    V02 -->|содержит| V03
    V04 -.->|аналитическая рамка для| V01

    %% Субъекты и объекты
    B05 -->|содействует| B01
    B05 -->|отвечает перед| B02

    %% Стили
    classDef containerBlock fill:#dce8f0,stroke:#4a7c9b,stroke-width:2px,color:#1a3a4a
    classDef subjectBlock fill:#e8e0d8,stroke:#8b7355,stroke-width:2px,color:#3a2a1a
    classDef objectBlock fill:#d8e8d0,stroke:#5a7b4a,stroke-width:2px,color:#1a3a1a

    class A01,A02,A03,A04,A05 containerBlock
    class B01,B02,B03,B04,B05 subjectBlock
    class V01,V02,V03,V04 objectBlock
